# ==============================================================================
# SMKS Prasetya Makassar - Apache Configuration & SEO Optimization
# ==============================================================================

# 1. Nonaktifkan penjelajahan direktori (Directory Browsing) untuk keamanan
Options -Indexes

# 2. Keamanan: Blokir akses langsung ke berkas sensitif
<FilesMatch "^(database\.sql|\.git.*|.*\.env|config/.*)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Modul Rewrite untuk SEO-Friendly URLs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan rewrite jika file atau folder fisik benar-benar ada
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URL untuk Halaman Utama Publik
    RewriteRule ^guru/?$ guru.php [L,QSA]
    RewriteRule ^fasilitas/?$ fasilitas.php [L,QSA]
    RewriteRule ^alumni/?$ alumni.php [L,QSA]
    RewriteRule ^beranda/?$ index.php [L,QSA]

    # Clean URL untuk Berita: /berita/1 atau /berita/1-judul-artikel-seo
    RewriteRule ^berita/([0-9]+)(?:-[a-zA-Z0-9_-]+)?/?$ detail-berita.php?id=$1 [L,QSA]

    # Dynamic Sitemap routing jika diminta
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# 4. Browser Caching untuk Aset Statis (Meningkatkan PageSpeed & FCP)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Kompresi Transfer Gzip / Deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>

